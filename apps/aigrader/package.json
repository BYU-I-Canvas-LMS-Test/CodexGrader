{
  "name": "@aigrader/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The aigrader command: the one local server per machine (review UI + in-process engine + control pipe) and its CLI.",
  "type": "module",
  "bin": {
    "aigrader": "bin/aigrader.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aigrader/canvas": "workspace:*",
    "@aigrader/engine": "workspace:*",
    "@aigrader/shared": "workspace:*",
    "express": "^4.21.0",
    "light-my-request": "^6.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}

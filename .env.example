# BYU-(A)I Grader settings — copy to ~/.aigrader/.env
# (Windows: %USERPROFILE%\.aigrader\.env) and fill in the two lines below.
# This file holds your Canvas access token: keep it private, never share it,
# and never commit it anywhere.

# Your Canvas address (what you see in the browser's address bar).
CANVAS_BASE_URL=https://byui.instructure.com

# Canvas → Account → Settings → "+ New Access Token". Paste the whole token.
CANVAS_API_TOKEN=

# Optional: a second Canvas instance.
# CANVAS_BASE_URL_2=
# CANVAS_API_TOKEN_2=

# Optional tuning (defaults shown).
# AIGRADER_MODEL=
# AIGRADER_REASONING_EFFORT=medium
# AIGRADER_MAX_WORKERS=2
# AIGRADER_UI_PORT=47821
# CODEX_PATH=
